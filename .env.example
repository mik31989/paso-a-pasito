# Puerto en el que corre la app
PORT=3000

# Secreto para firmar los JWT de sesión (cámbialo por uno propio y largo)
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio

# Base de datos:
# - Para desarrollo local, deja esto así (crea un archivo local data/reto.db)
DATABASE_URL=file:./data/reto.db
DATABASE_AUTH_TOKEN=

# --- Para producción en hosting gratuito (recomendado: Turso) ---
# 1. Crea una base gratuita en https://turso.tech
# 2. turso db create paso-a-pasito
# 3. turso db show paso-a-pasito --url          -> pega aquí en DATABASE_URL (empieza con libsql://)
# 4. turso db tokens create paso-a-pasito        -> pega aquí en DATABASE_AUTH_TOKEN
# DATABASE_URL=libsql://paso-a-pasito-tuusuario.turso.io
# DATABASE_AUTH_TOKEN=eyJhbGciOi...

# Fechas y nombre por defecto del reto si aún no se han configurado desde el admin (YYYY-MM-DD)
RETO_NOMBRE_DEFAULT=Paso a Pasito
RETO_INICIO_DEFAULT=2026-09-01
RETO_FIN_DEFAULT=2026-09-30

# Sufijo fijo que se concatena al usuario para generar la contraseña inicial de cada participante
# (usuario = No. de expediente, contraseña = expediente + este sufijo)
SUFIJO_PASSWORD=uninet2026

# Token temporal para crear el primer administrador desde el navegador, en /setup-admin
# (útil en hostings sin acceso a terminal, como el plan gratuito de Render).
# Ponle cualquier valor largo y aleatorio. Una vez creado el primer admin, puedes
# quitar esta variable si quieres; la ruta deja de funcionar sola en cuanto ya existe un admin.
SETUP_TOKEN=cambia-esto-por-otro-secreto-largo
