<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Paso a Pasito · Ingreso</title>
  <link rel="stylesheet" href="/public/css/style.css" />
</head>
<body class="pagina-login">
  <div class="tarjeta-login">
    <div class="logo-login">🚶‍♂️ Paso a Pasito</div>
    <p class="subtitulo-login">Reto de pasos entre compañeros</p>

    <% if (error) { %>
      <div class="alerta alerta-error"><%= error %></div>
    <% } %>

    <form method="POST" action="/login" class="form-login">
      <label for="username">Usuario</label>
      <input type="text" id="username" name="username" autocomplete="username" required autofocus />

      <label for="password">Contraseña</label>
      <input type="password" id="password" name="password" autocomplete="current-password" required />

      <button type="submit" class="btn btn-primario btn-ancho">Ingresar</button>
    </form>
  </div>
</body>
</html>
